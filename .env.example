# TwitTUI Configuration Template
# Copy to .env (or let the Snap launcher initialize $SNAP_USER_DATA/.env automatically).
# Obtain free TWiT API credentials at https://apidocs.twit.tv/
#
# Optional keys are commented out so launcher-provided defaults (such as strict Snap
# `TWITCLUBSTREAMER="mpv %f"` and `TWITCLUBDESTINATION="$HOME/Downloads"`) are not
# overwritten with blank values on startup.

# TWITAPI_APPLICATIONID=
# TWITAPI_APPLICATIONKEYS=
# TWITCLUBURL=
# TWITCLUBDESTINATION=
TWITCLUBBLOCKSIZE=65535
TWITAPIRATELIMIT=5
# Desktop default: env LC_ALL=C vlc %f  (strict Snap bundles mpv %f + ffmpeg)
# TWITCLUBSTREAMER=
TWITCLUBSHOWFOLDERS=0
TWITAUDIOONLY=0
TWITFUZZYSEARCH=1
TWITPHONETICSEARCH=1
